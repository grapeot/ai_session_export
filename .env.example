# Environment variables for ai_session_export (all optional).
# Copy to .env and fill in if your paths differ from defaults.

# OpenCode database path (default: ~/.local/share/opencode/opencode.db)
# OPENCODE_DB=~/.local/share/opencode/opencode.db

# Second Mind export JSON path (default: ./second_mind_export.json)
# SECOND_MIND_JSON=./second_mind_export.json

# Antigravity IDE brain directory (default: ~/.gemini/antigravity-ide/brain)
# ANTIGRAVITY_BRAIN_DIR=~/.gemini/antigravity-ide/brain

# Set to 1 to enable live end-to-end tests against real local data
# AI_SESSION_EXPORT_LIVE=0
